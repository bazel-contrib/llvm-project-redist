# Take zlib, zstd, mpfr and libpfm from the BCR instead of disabling them.
#
# This release reached these through WORKSPACE-era http_archive repos with LLVM's
# own BUILD files. The generated MODULE.bazel now declares the BCR modules
# upstream main uses (zlib-ng as @llvm_zlib, zstd as @llvm_zstd, mpfr, gmp,
# libpfm as @pfm), and this patch mirrors upstream's consumer side:
# //third-party:zlib and :zstd wrappers (9626c90c335c, ac4cf404d8f3) carry the
# LLVM_ENABLE_* defines, and the mpfr/pfm selects point at the BCR targets with
# local libmpfr_system/libpfm_system shims (ef86984f539f). Two redist additions:
# `pfm_external` is limited to Linux, since libpfm is Linux-only and the BCR
# module has no gate, and mpfr_impl inherits libc's Windows incompatibility.
diff --git a/libc/BUILD.bazel b/libc/BUILD.bazel
--- a/libc/BUILD.bazel
+++ b/libc/BUILD.bazel
@@ -64,6 +64,13 @@ config_setting(
     flag_values = {":mpfr": "system"},
 )
 
+cc_library(
+    name = "libmpfr_system",
+    linkopts = ["-lmpfr"],
+    tags = ["manual"],
+    visibility = ["//libc:__subpackages__"],
+)
+
 # This empty root library helps us add an include path to this directory
 # using the 'includes' attribute. The strings listed in the includes attribute
 # are relative paths wrt this library but are inherited by the dependents
diff --git a/libc/utils/MPFRWrapper/BUILD.bazel b/libc/utils/MPFRWrapper/BUILD.bazel
--- a/libc/utils/MPFRWrapper/BUILD.bazel
+++ b/libc/utils/MPFRWrapper/BUILD.bazel
@@ -5,6 +5,7 @@
 # A wrapper library over MPFR for use with LLVM libc math unittests.
 
 load("@rules_cc//cc:cc_library.bzl", "cc_library")
+load("//libc:libc_build_rules.bzl", "LIBC_INCOMPATIBLE_WITH_WINDOWS")
 
 package(default_visibility = ["//visibility:public"])
 
@@ -16,12 +17,12 @@ cc_library(
     target_compatible_with = select({
         "//conditions:default": [],
         "//libc:mpfr_disable": ["@platforms//:incompatible"],
-    }),
+    }) + LIBC_INCOMPATIBLE_WITH_WINDOWS,
     deps = select(
         {
             "//conditions:default": [],
-            "//libc:mpfr_external": ["@mpfr//:mpfr_external"],
-            "//libc:mpfr_system": ["@mpfr//:mpfr_system"],
+            "//libc:mpfr_external": ["@mpfr"],
+            "//libc:mpfr_system": ["//libc:libmpfr_system"],
         },
     ),
 )
diff --git a/lld/BUILD.bazel b/lld/BUILD.bazel
--- a/lld/BUILD.bazel
+++ b/lld/BUILD.bazel
@@ -110,8 +110,8 @@ cc_library(
         "//llvm:TargetParser",
         "//llvm:TransformUtils",
         "//llvm:config",
-        "@llvm_zlib//:zlib",
-        "@llvm_zstd//:zstd",
+        "//third-party:zlib",
+        "//third-party:zstd",
     ],
 )
 
diff --git a/llvm/BUILD.bazel b/llvm/BUILD.bazel
--- a/llvm/BUILD.bazel
+++ b/llvm/BUILD.bazel
@@ -341,11 +341,11 @@ cc_library(
         # We unconditionally depend on the custom LLVM zlib wrapper. This will
         # be an empty library unless zlib is enabled, in which case it will
         # both provide the necessary dependencies and configuration defines.
-        "@llvm_zlib//:zlib",
+        "//third-party:zlib",
         # We unconditionally depend on the custom LLVM zstd wrapper. This will
         # be an empty library unless zstd is enabled, in which case it will
         # both provide the necessary dependencies and configuration defines.
-        "@llvm_zstd//:zstd",
+        "//third-party:zstd",
     ],
 )
 
@@ -3042,8 +3042,11 @@ config_setting(
     flag_values = {":pfm": "disable"},
 )
 
+# libpfm is Linux-only (perf_event) and the BCR module has no platform gate
+# of its own, so `external` is a no-op elsewhere.
 config_setting(
     name = "pfm_external",
+    constraint_values = ["@platforms//os:linux"],
     flag_values = {":pfm": "external"},
 )
 
@@ -3052,6 +3055,16 @@ config_setting(
     flag_values = {":pfm": "system"},
 )
 
+cc_library(
+    name = "libpfm_system",
+    linkopts = ["-lpfm"],
+    tags = ["manual"],
+    target_compatible_with = select({
+        "@platforms//os:linux": [],
+        "//conditions:default": ["@platforms//:incompatible"],
+    }),
+)
+
 cc_library(
     name = "maybe_pfm",
     # We want dependencies of this library to have -DHAVE_LIBPFM conditionally
@@ -3062,8 +3075,8 @@ cc_library(
         "//conditions:default": [],
     }),
     deps = select({
-        ":pfm_external": ["@pfm//:pfm_external"],
-        ":pfm_system": ["@pfm//:pfm_system"],
+        ":pfm_external": ["@pfm"],
+        ":pfm_system": [":libpfm_system"],
         "//conditions:default": [],
     }),
 )
diff --git b/third-party/BUILD.bazel b/third-party/BUILD.bazel
new file mode 100644
--- /dev/null
+++ b/third-party/BUILD.bazel
@@ -0,0 +1,65 @@
+# This file is licensed under the Apache License v2.0 with LLVM Exceptions.
+# See https://llvm.org/LICENSE.txt for license information.
+# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+
+load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
+load(":cc_library_wrapper.bzl", "cc_library_wrapper")
+
+package(default_visibility = ["//visibility:public"])
+
+bool_flag(
+    name = "llvm_enable_zstd",
+    build_setting_default = True,
+)
+
+config_setting(
+    name = "llvm_zstd_enabled",
+    flag_values = {":llvm_enable_zstd": "true"},
+)
+
+cc_library_wrapper(
+    name = "zstd",
+    defines = select({
+        ":llvm_zstd_enabled": [
+            "LLVM_ENABLE_ZSTD=1",
+            "ZSTD_MULTITHREAD",
+        ],
+        "//conditions:default": [
+            "LLVM_ENABLE_ZSTD=0",
+        ],
+    }),
+    deps = select({
+        ":llvm_zstd_enabled": [
+            "@llvm_zstd//:zstd",
+        ],
+        "//conditions:default": [],
+    }),
+)
+
+bool_flag(
+    name = "llvm_enable_zlib",
+    build_setting_default = True,
+)
+
+config_setting(
+    name = "llvm_zlib_enabled",
+    flag_values = {":llvm_enable_zlib": "true"},
+)
+
+cc_library_wrapper(
+    name = "zlib",
+    defines = select({
+        ":llvm_zlib_enabled": [
+            "LLVM_ENABLE_ZLIB=1",
+        ],
+        "//conditions:default": [
+            "LLVM_ENABLE_ZLIB=0",
+        ],
+    }),
+    deps = select({
+        ":llvm_zlib_enabled": [
+            "@llvm_zlib//:zlib-ng",
+        ],
+        "//conditions:default": [],
+    }),
+)
diff --git b/third-party/cc_library_wrapper.bzl b/third-party/cc_library_wrapper.bzl
new file mode 100644
--- /dev/null
+++ b/third-party/cc_library_wrapper.bzl
@@ -0,0 +1,63 @@
+# This file is licensed under the Apache License v2.0 with LLVM Exceptions.
+# See https://llvm.org/LICENSE.txt for license information.
+# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+
+"""Re-export a cc_library with added LLVM specific settings.
+
+This re-exports the dependent libraries in a way that satisfies layering_check
+
+cc_library_wrapper(
+    name = "library_wrapper",
+    deps = [
+        "@example//:library",
+    ],
+    defines = [
+        "LLVM_ENABLE_EXAMPLE=1",
+    ],
+)
+"""
+
+load("@rules_cc//cc/common:cc_common.bzl", "cc_common")
+load("@rules_cc//cc/common:cc_info.bzl", "CcInfo")
+
+visibility("private")
+
+def _cc_library_wrapper_impl(ctx):
+    all_cc_infos = [dep[CcInfo] for dep in ctx.attr.deps]
+    if ctx.attr.defines:
+        all_cc_infos.append(CcInfo(
+            compilation_context = cc_common.create_compilation_context(
+                defines = depset(ctx.attr.defines),
+            ),
+        ))
+    if ctx.attr.linkopts:
+        all_cc_infos.append(CcInfo(
+            linking_context = cc_common.create_linking_context(
+                linker_inputs = depset([cc_common.create_linker_input(
+                    owner = ctx.label,
+                    user_link_flags = depset(ctx.attr.linkopts),
+                )]),
+            ),
+        ))
+
+    return cc_common.merge_cc_infos(direct_cc_infos = all_cc_infos)
+
+cc_library_wrapper = rule(
+    implementation = _cc_library_wrapper_impl,
+    attrs = {
+        "deps": attr.label_list(
+            doc = "Dependencies to cc_library targets to re-export.",
+            providers = [CcInfo],
+        ),
+        "defines": attr.string_list(
+            doc = "Additional preprocessor definitions to add to all dependent targets.",
+            default = [],
+        ),
+        "linkopts": attr.string_list(
+            doc = "Additional linker flags to add to all dependent targets.",
+            default = [],
+        ),
+    },
+    doc = "Re-export a cc_library with added LLVM specific settings.",
+    provides = [CcInfo],
+)
