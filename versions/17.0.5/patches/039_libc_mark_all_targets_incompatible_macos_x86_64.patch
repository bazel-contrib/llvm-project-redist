# No upstream equivalent, by design, for the same reason as the Windows gate in
# 029: upstream has no x86_64 Darwin backend and only builds libc on macOS
# arm64, so a rule-level gate would not be accepted there. In this release the
# failure is concrete: on an Intel Mac src/__support/OSUtil/darwin/syscall.h
# #errors "Unsupported architecture", which takes down __support_osutil_io and
# with it libc/test/UnitTest:test_logger, libc:printf_converter and every libc
# test. Gating mpfr_impl too keeps @mpfr/@gmp out of that build; gmp
# 6.3.0.bcr.4 is only tested on macos_arm64 in the BCR and its x86_64 mpn
# assembly does not assemble with the Mach-O assembler ("invalid alignment
# value" on `.align 32, 0x90`).
diff --git a/libc/BUILD.bazel b/libc/BUILD.bazel
index 8d8caa482..148a21872 100644
--- a/libc/BUILD.bazel
+++ b/libc/BUILD.bazel
@@ -64,6 +64,15 @@ config_setting(
     flag_values = {":mpfr": "system"},
 )
 
+# macOS on x86_64: see LIBC_INCOMPATIBLE_WITH_MACOS_X86_64 in libc_build_rules.bzl.
+config_setting(
+    name = "macos_x86_64",
+    constraint_values = [
+        "@platforms//cpu:x86_64",
+        "@platforms//os:macos",
+    ],
+)
+
 cc_library(
     name = "libmpfr_system",
     linkopts = ["-lmpfr"],
diff --git a/libc/libc_build_rules.bzl b/libc/libc_build_rules.bzl
