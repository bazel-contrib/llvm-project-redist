         copts = copts,
         linkstatic = 1,
         target_compatible_with = target_compatible_with +
-                                 LIBC_INCOMPATIBLE_WITH_WINDOWS,
+                                 LIBC_INCOMPATIBLE_WITH_WINDOWS +
+                                 LIBC_INCOMPATIBLE_WITH_MACOS_X86_64,
         **kwargs
     )
 
@@ -120,7 +135,8 @@ def libc_function(
         copts = copts,
         linkstatic = 1,
         target_compatible_with = target_compatible_with +
