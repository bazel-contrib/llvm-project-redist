# Local equivalent of:
# Upstream-Commit: https://github.com/llvm/llvm-project/commit/4e0a7f20a90e7c9f41fe73ac337f00f93ebbbf12
#
# Upstream keys the MASM files on the msvc-cl compiler and keeps the GAS file
# for clang-cl and mingw. This release predates the BLAKE3 pattern list, and
# the select is keyed on x86_64 Windows rather than on the compiler because the
# compiler identity the Windows toolchain reports differs between Bazel 7 and
# 8+ (see the clang-cl notes in .bazelrc), so clang-cl assembles the MASM files
# here too. Both the msvc and clang-cl CI tasks pass with it; mingw is not a
# toolchain this release's overlay supports.
diff --git a/llvm/BUILD.bazel b/llvm/BUILD.bazel
index a7e9398ea8fd..d14ea2957d4a 100644
--- a/llvm/BUILD.bazel
+++ b/llvm/BUILD.bazel
@@ -192,6 +192,14 @@ genrule(
           "echo -e '#undef HANDLE_EXTENSION' >> $@\n",
 )
 
+config_setting(
+    name = "amd64-windows",
+    constraint_values = [
+        "@platforms//os:windows",
+        "@platforms//cpu:x86_64",
+    ],
+)
+
 cc_library(
     name = "Support",
     srcs = glob([
@@ -220,6 +228,12 @@ cc_library(
         "@platforms//cpu:aarch64": [
             "lib/Support/BLAKE3/blake3_neon.c",
         ],
+        ":amd64-windows": [
+            "lib/Support/BLAKE3/blake3_avx2_x86-64_windows_msvc.asm",
+            "lib/Support/BLAKE3/blake3_avx512_x86-64_windows_msvc.asm",
+            "lib/Support/BLAKE3/blake3_sse2_x86-64_windows_msvc.asm",
+            "lib/Support/BLAKE3/blake3_sse41_x86-64_windows_msvc.asm",
+        ],
         "@platforms//cpu:x86_64": [
             "lib/Support/BLAKE3/blake3_avx2_x86-64_unix.S",
             "lib/Support/BLAKE3/blake3_avx512_x86-64_unix.S",
