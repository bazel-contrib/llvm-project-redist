# Upstream-Commit: https://github.com/llvm/llvm-project/commit/20a018a6d9e13575b1aac2625e9db46b5da6676a
#
# "[bazel] Use `includes` for per-target lib/Target dirs to fix
# -Wmicrosoft-include" (#228282). MCTargetDesc/RISCVTargetStreamer.h does
# `#include "RISCV.h"` from its parent directory. Reached from
# RISCVAsmPrinter.cpp, clang-cl's Microsoft include rule finds the real
# lib/Target/RISCV/RISCV.h while the ordinary lookup first hits the
# `_virtual_includes` copy that `strip_include_prefix` creates (a copy, not a
# symlink, on Windows), and clang reports the mismatch under
# -Wmicrosoft-include, fatal with the clang-cl config's -Werror. Exposing
# lib/Target/<name> through `includes` on the generated UtilsAndDesc/CodeGen
# rules leaves no copy, so both lookups agree. Same hunks as upstream, on
# `gentbl` instead of `gentbl_cc_library`; the one comment upstream edited in
# `hdrs` sits in `srcs` in this release.
diff --git a/llvm/BUILD.bazel b/llvm/BUILD.bazel
index 8f0a107..a1ea66b 100644
--- a/llvm/BUILD.bazel
+++ b/llvm/BUILD.bazel
@@ -2250,11 +2250,7 @@ gentbl(
         srcs = ["lib/Target/" + target["name"] + "/TargetInfo/" + target["name"] + "TargetInfo.cpp"],
         hdrs = glob(["lib/Target/" + target["name"] + "/TargetInfo/*.h"]),
         copts = llvm_copts,
-        # Workaround for https://github.com/bazelbuild/bazel/issues/3828
-        # TODO(gcmn): Remove this when upgrading to a Bazel version containing
-        # https://github.com/bazelbuild/bazel/commit/e3b7e17b05f1
         includes = ["lib/Target/" + target["name"]],
-        strip_include_prefix = "lib/Target/" + target["name"],
         deps = [
             ":" + target["name"] + "CommonTableGen",
             ":MC",
@@ -2273,8 +2269,8 @@ gentbl(
                 # We have to include these headers here as well as in the `hdrs`
                 # below to allow the `.cpp` files to use file-relative-inclusion to
                 # find them, even though consumers of this library use inclusion
-                # relative to the target with the `strip_includes_prefix` of this
-                # library. This mixture is likely incompatible with header modules.
+                # relative to the target directory via `includes`. This mixture is
+                # likely incompatible with header modules.
                 "lib/Target/" + target["name"] + "/MCTargetDesc/*.h",
                 "lib/Target/" + target["name"] + "/Utils/*.h",
             ],
@@ -2292,9 +2288,9 @@ gentbl(
                 # listing of these headers in the `srcs` of subsequent rules.
                 "lib/Target/" + target["name"] + "/*.h",
                 # FIXME: The entries below should be `textual_hdrs` instead of
-                # `hdrs`, but unfortunately that doesn't work with
-                # `strip_include_prefix`:
-                # https://github.com/bazelbuild/bazel/issues/12424
+                # `hdrs`. That was blocked by `strip_include_prefix`
+                # (https://github.com/bazelbuild/bazel/issues/12424), which this
+                # rule no longer uses.
                 #
                 # Once that issue is fixed and released, we can switch this to
                 # `textual_hdrs` and remove the feature disabling the various Bazel
@@ -2312,7 +2308,13 @@ gentbl(
             "-header_modules",
             "-layering_check",
         ],
-        strip_include_prefix = "lib/Target/" + target["name"],
+        # `includes` rather than `strip_include_prefix`: the prefix exposes the
+        # headers through a `_virtual_includes` copy, and when a header includes
+        # one from its parent directory (MCTargetDesc/RISCVTargetStreamer.h
+        # -> "RISCV.h") clang-cl's Microsoft include rule finds the real file,
+        # sees the ordinary lookup land on the copy, and rejects the mismatch
+        # under -Wmicrosoft-include. With `includes` both lookups agree.
+        includes = ["lib/Target/" + target["name"]],
         deps = [
             ":BinaryFormat",
             # Depending on `:CodeGen` headers in this library is almost
@@ -2344,7 +2346,8 @@ gentbl(
         hdrs = ["lib/Target/" + target["name"] + "/" + target["short_name"] + ".h"],
         copts = llvm_copts,
         features = ["-layering_check"],
-        strip_include_prefix = "lib/Target/" + target["name"],
+        # See the `includes` note on the `UtilsAndDesc` rule above.
+        includes = ["lib/Target/" + target["name"]],
         textual_hdrs = glob(
             [
                 "lib/Target/" + target["name"] + "/*.def",
