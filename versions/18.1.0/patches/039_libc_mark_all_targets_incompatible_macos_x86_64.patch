-    }) + LIBC_INCOMPATIBLE_WITH_WINDOWS,
+    }) + LIBC_INCOMPATIBLE_WITH_WINDOWS + LIBC_INCOMPATIBLE_WITH_MACOS_X86_64,
     deps = select(
         {
             "//conditions:default": [],
